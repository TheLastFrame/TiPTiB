TIPTIB_DATABASE_URL=sqlite:///./data/tiptib.db
TIPTIB_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
TIPTIB_ENVIRONMENT=development
TIPTIB_ALLOWED_HOSTS=localhost,127.0.0.1
TIPTIB_SESSION_COOKIE_SECURE=false
TIPTIB_DEFAULT_CURRENCY=EUR
TIPTIB_DEFAULT_LOCALE=de_AT
TIPTIB_DEFAULT_TIMEZONE=Europe/Vienna
TIPTIB_RUN_MIGRATIONS_ON_STARTUP=true
# Optional first-run bootstrap instead of web setup:
# TIPTIB_BOOTSTRAP_USERNAME=admin
# TIPTIB_BOOTSTRAP_PASSWORD=replace-with-a-long-admin-password
# Only set this intentionally for production web setup without bootstrap:
# TIPTIB_ALLOW_WEB_SETUP=false
